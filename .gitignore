# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Private notes (CV, drafts) live here and are never committed.
Docs/

# Claude Code session-local config: the dev-server launch entry and any
# permission settings. Machine-local tooling, not site content. The skills
# in .claude/skills/ are the exception: they ship with the template.
.claude/*
!.claude/skills/
